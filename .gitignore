# Python
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.venv/

# Data (never commit). The fish oil data is private and is read from the warpalign checkout.
/data/
*.cdf
*.mzML
*.mzXML
*.npz
*.h5

# Outputs: no caches or binaries in git. Text reports and captions are tracked.
checkpoints/
*.pt
*.npy
*.pkl
/results/*
!/results/*.txt
/figs/**/*.png
/figs/**/*.pdf
# Draft-run figures are small and shared for the paper draft.
!/figs/draft/*.png
logs/
*.log

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Test artefacts
.coverage
.pytest_cache/
junit.xml
